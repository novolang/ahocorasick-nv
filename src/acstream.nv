// acstream.nv — searching a haystack that arrives in pieces.
//
// A pattern may straddle a chunk boundary: `hers` split as `he` and
// `rs` is a match that neither chunk contains.  The stream state is a
// value that carries three things across the boundary: the automaton
// state the last chunk ended in, the absolute offset the stream has
// reached, and a tail of the most recent bytes.
//
// The tail is the longest suffix of the stream that a later byte can
// still extend into a match.  It is never longer than `max_carry`, one
// byte less than the longest pattern, so the memory a stream holds does
// not grow with the length of the stream.
//
// The matches `feed` reports carry offsets into the whole stream, not
// into the chunk that completed them.
//
// Under standard semantics a match is final the moment it is seen.
// Under either leftmost semantics it is not: `Sam` at offset 4 may
// still lose to `Samwise`, and whether it does depends on bytes that
// have not arrived.  `feed` reports only what no later byte can
// change, `is_settled` says whether a candidate is being held back,
// and `finish` releases it at the end of the stream.  A caller that
// does not call `finish` loses the last match of the stream.

use acauto
use acmatch
use acscan

// A stream search in progress.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["hers"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  => println("${acstream.stream_offset(acstream.stream(a))}")   // 0
// ```
pub struct AcStreamState
    // The automaton being searched with.
    automaton: acauto.AcAutomaton
    // The automaton state the last chunk ended in.
    node: Int
    // How many bytes of the stream have been consumed.  The next byte
    // to arrive is at this offset.
    consumed: Int
    // The most recent bytes of the stream that a later byte can still
    // extend into a match, at most `max_carry` of them.  A held
    // candidate never starts before them.
    tail: Str
    // A leftmost candidate that a later byte could still beat, or
    // `None`.  Always `None` under standard semantics.
    pending: ?acmatch.AcMatch

// What one `feed` or `finish` produced.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["he"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  =>
//             let f = acstream.feed(acstream.stream(a), "ushers")
//             println("${list.len(f.matches)}")
// ```
pub struct AcFeed
    // The state to hand to the next `feed`, or to `finish`.
    state: AcStreamState
    // The matches that became final during this call, in order, with
    // offsets into the whole stream.
    matches: [acmatch.AcMatch]

// A stream search over an automaton, at offset zero.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["hers"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  => println("${acstream.carried_bytes(acstream.stream(a))}")   // 0
// ```
pub fn stream(a: acauto.AcAutomaton) -> AcStreamState []
    AcStreamState { automaton: a, node: 0, consumed: 0, tail: "", pending: None }

// Consume one chunk, and report the matches it made final.
//
// A chunk may be any length, including empty.  The same stream split
// differently produces the same matches at the same offsets, which is
// the property the suite asserts by feeding `ushers` one byte at a
// time.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["hers"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  =>
//             let one = acstream.feed(acstream.stream(a), "ushe")
//             let two = acstream.feed(one.state, "rs")
//             println("${list.len(two.matches)}")     // 1
// ```
pub fn feed(s: AcStreamState, chunk: Str) -> AcFeed []
    advance(s, chunk, false)

// End the stream, and report whatever was being held back.
//
// Under standard semantics this always answers an empty list, because
// nothing is ever held back.  Under either leftmost semantics it is
// the call that releases the last candidate, and a caller that omits
// it loses the last match of the stream.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     let c = acauto.with_kind(acauto.config(), AcLeftmostLongest)
//     match acauto.build_with(["Sam", "Samwise"], c)
//         Err(_) => println("the set is not usable")
//         Ok(a)  =>
//             let f = acstream.feed(acstream.stream(a), "Samwise")
//             println("${list.len(acstream.finish(f.state).matches)}")   // 1
// ```
pub fn finish(s: AcStreamState) -> AcFeed []
    advance(s, "", true)

// How many bytes of the stream have been consumed.
//
// The offset the next byte will have, and the number every reported
// offset is measured against.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["he"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  =>
//             let f = acstream.feed(acstream.stream(a), "ushers")
//             println("${acstream.stream_offset(f.state)}")    // 6
// ```
pub fn stream_offset(s: AcStreamState) -> Int []
    s.consumed

// How many bytes the state is holding on to.
//
// Never more than `max_carry`, whatever the length of the stream.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["hers"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  =>
//             let f = acstream.feed(acstream.stream(a), "ushe")
//             println("${acstream.carried_bytes(f.state)}")
// ```
pub fn carried_bytes(s: AcStreamState) -> Int []
    str.len(s.tail)

// The most bytes a stream over this automaton will ever carry: one
// less than the longest pattern.
//
// A caller sizing a fixed buffer, or deciding whether a stream search
// fits on a device, asks this before starting.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["he", "hers"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  => println("${acstream.max_carry(a)}")    // 3
// ```
pub fn max_carry(a: acauto.AcAutomaton) -> Int []
    acauto.max_pattern_len(a) - 1

// Whether `finish` would report nothing.
//
// True when no candidate is being held back, so a caller that wants
// to stop reading early knows whether it has already seen everything.
//
// ```novo
// use acauto
// use acstream
//
// fn main() [io]
//     match acauto.build(["he"])
//         Err(_) => println("the set is not usable")
//         Ok(a)  => println("${acstream.is_settled(acstream.stream(a))}")   // true
// ```
pub fn is_settled(s: AcStreamState) -> Bool []
    match s.pending
        None    => true
        Some(_) => false

// Scan one chunk after the carried tail, and carry forward the bytes
// the automaton's state stands for.  With `at_end` the chunk is the
// last, and a held candidate is final.
fn advance(s: AcStreamState, chunk: Str, at_end: Bool) -> AcFeed
    let lt = str.len(s.tail)
    let base = s.consumed - lt
    let r = acscan.run(s.automaton, s.tail, chunk, base, lt, s.node, s.pending, at_end, 0 - 1)
    let end = s.consumed + str.len(chunk)
    let keep = s.automaton.depth[r.node]
    let lc = str.len(chunk)
    var tail = chunk
    if keep > lc
        tail = str.slice(s.tail, lt - (keep - lc), lt) + chunk
    else
        tail = str.slice(chunk, lc - keep, lc)
    let next = AcStreamState { automaton: s.automaton, node: r.node, consumed: end, tail: tail,
                               pending: r.pending }
    AcFeed { state: next, matches: r.matches }
